# Local PostgreSQL on loopback. scripts/ensure-database.sh creates the
# ubuntu role and crm_lab database, and allows passwordless trust
# authentication from 127.0.0.1 only. Copy to .env; do not commit .env.
DATABASE_URL="postgresql://ubuntu@127.0.0.1:5432/crm_lab"

# Tests that write to PostgreSQL. Required in the process environment
# (the test runner does not read this file). Must be a disposable database
# on 127.0.0.1, localhost, or ::1. crm_lab and production names are rejected.
# TEST_DATABASE_URL="postgresql://ubuntu@127.0.0.1:5432/crm_phase32_test"

# Signs the session cookie. At least 32 characters. Generate it outside git.
# Never commit a real value. The test runner supplies its own secret.
# CRM_LAB_SESSION_SECRET=
# CRM_LAB_SESSION_TTL_SECONDS=43200
# Set to true only behind HTTPS. Leave unset for http://127.0.0.1.
# CRM_LAB_COOKIE_SECURE=true
