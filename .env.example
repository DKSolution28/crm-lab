# Local development only. These credentials are created by
# scripts/cloud/db-setup.sh on the Cloud Agent VM; they are not real secrets.
# Real secrets belong in Cursor Dashboard > Cloud Agents > Secrets, never in git.
DATABASE_URL="postgresql://crm_lab:crm_lab@localhost:5432/crm_lab?schema=public"

# Base URL used by Playwright e2e tests and scripts/cloud/verify.sh
CRM_LAB_BASE_URL="http://localhost:3000"
