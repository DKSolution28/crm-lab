    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "1.64.0",
